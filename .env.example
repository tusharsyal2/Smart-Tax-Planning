# Smart Tax Planning Assistance Environment Configuration Template
APP_NAME="Smart Tax Planning Assistance"
APP_ENV="local"
APP_DEBUG=false
APP_URL="http://localhost/smart-tax-planning"

# Database Configuration (XAMPP default user is root with empty password or your custom password)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="smart_tax_planning"
DB_USER="root"
DB_PASS=""

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Tax Defaults
DEFAULT_FINANCIAL_YEAR="2024-25"
DEFAULT_CURRENCY="INR"
